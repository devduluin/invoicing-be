# Copy to .env (same directory as docker-compose.yml) and adjust for your setup. Every value
# has a working default baked into docker-compose.yml — override only what differs.

APP_ENV=development

# Postgres container this compose file starts for you
DATABASE_USER=postgres
DATABASE_PASSWORD=12345678
DATABASE_NAME=invoice_service_db
DATABASE_PORT=5432

# Redis container this compose file starts for you
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# SSO / Launchpad — separate products, NOT started by this compose file. Defaults assume
# Docker Desktop reaching services on your host machine (e.g. a local Laragon vhost).
SSO_URL=http://sso.test/api
LAUNCHPAD_URL=http://host.docker.internal:3000
INVOICE_WEB_URL=http://localhost:3010

API_KEY=
INVOICE_OWNER_ROLE_ID=
USE_LOCAL_RBAC=true
RBAC_MIGRATION_FALLBACK=true
BANK_META_URL=https://dev-dashboard.duluin.com/api/meta/bank
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:9996

INVOICE_BE_PORT=8090
