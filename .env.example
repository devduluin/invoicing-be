# ── App ──────────────────────────────────────────
APP_NAME=invoice-service
APP_ENV=development
APP_PORT=8090

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=12345678
DATABASE_NAME=invoice_service_db

# ── Redis (token validation cache) ───────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ── SSO (Duluin Launchpad auth) ──────────────────
# Local dev talks straight to the SSO service (same as acc-master-service).
# Account type registered in SSO for this product (see DuluinInvoiceSeeder).
SSO_ACCOUNT_TYPE=duluin_invoice
SSO_URL=http://sso.test/api
LAUNCHPAD_URL=http://localhost:3000

# Public URL of invoice-frontend — used to build invite accept links (PRD §4 Step 4)
INVOICE_WEB_URL=http://localhost:3010

# Duluin bank directory (Indonesian banks + codes) for the "Akun Bank" dropdown.
BANK_META_URL=https://dev-dashboard.duluin.com/api/meta/bank
# Dev remote alternative:
# SSO_URL=https://ssodev.duluin.com/api
# LAUNCHPAD_URL=https://dev-launchpad.duluin.id

# ── RBAC (acc-master pattern: role/permission live in SSO) ────────
# Bearer fallback for internal SSO calls that need auth (rolesData/*).
API_KEY=
# Resolve role_id → permissions locally per company (default ON — greenfield).
USE_LOCAL_RBAC=true
# Safety net while data backfills: fall back to signin-cookies roles/perms
# when a membership has no role_id or SSO role read fails (default ON).
RBAC_MIGRATION_FALLBACK=true
# Optional pin for the global "Invoice Owner" SSO role id (else resolved by name).
INVOICE_OWNER_ROLE_ID=

# ── CORS ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:9996
